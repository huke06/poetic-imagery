# 数据库（默认 SQLite 单文件，无需修改）
# DATABASE_URL=sqlite:///./shixiangzhi.db

# 上游开放数据接口（可选）
UPSTREAM_WRITING_BASE=https://open.cnkgraph.com
UPSTREAM_BOOK_BASE=https://api.cnkgraph.com

# 大模型（可选；留空则智能助手使用本地知识库生成）
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 管理后台令牌
ADMIN_TOKEN=shixiangzhi-admin
